# Copy this file to .env.local, fill in the values, then run:
#   node scripts/set-apple-secrets.mjs
# .env.local is gitignored and must never be committed.

# App Store Connect > Users and Access > Integrations. This is the issuer UUID
# shown above the key table, not the API key ID.
ASC_ISSUER_ID=

# API key ID and the local path to its one-time-download .p8 file. The key ID
# is derived from the filename (AuthKey_<ID>.p8) when left blank.
ASC_KEY_ID=
ASC_KEY_P8_PATH=

# App Review contact shown to Apple's reviewers. Personal data, so it is never
# committed; the metadata workflow reads it from GitHub secrets.
REVIEW_CONTACT_FIRST_NAME=
REVIEW_CONTACT_LAST_NAME=
REVIEW_CONTACT_PHONE=
REVIEW_CONTACT_EMAIL=

# The passphrase used to encrypt the shared fastlane-match repository.
MATCH_PASSWORD=

# Fine-grained/classic GitHub token that can write ios-certificates. The helper
# derives the basic-auth value match needs; the raw token is not uploaded.
GITHUB_PAT=
GITHUB_USERNAME=
