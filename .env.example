# Copy this file to .env.local, fill in the values, then run:
#   node scripts/set-apple-secrets.mjs
# .env.local is gitignored and must never be committed.

# App Store Connect > Users and Access > Integrations. This is the issuer UUID
# shown above the key table, not the API key ID.
ASC_ISSUER_ID=

# API key ID and the local path to its one-time-download .p8 file.
ASC_KEY_ID=C9752W9BM5
ASC_KEY_P8_PATH=C:\Users\Isaac\Documents\GitHub\flipdash\AuthKey_C9752W9BM5.p8

# The passphrase used to encrypt the shared fastlane-match repository.
MATCH_PASSWORD=

# Fine-grained/classic GitHub token that can write ios-certificates. The helper
# derives the basic-auth value match needs; the raw token is not uploaded.
GITHUB_PAT=
GITHUB_USERNAME=isaacgriffiths
