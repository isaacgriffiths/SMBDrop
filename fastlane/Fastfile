default_platform(:ios)

# These are methods rather than top-level constants. Fastlane parses this file
# before selecting a lane, so eager ENV.fetch calls would make init_signing
# require build-only variables such as APP_PROJECT.
def project_path
  ENV.fetch("APP_PROJECT")
end

def scheme_name
  ENV.fetch("APP_SCHEME")
end

def bundle_id
  ENV.fetch("APP_BUNDLE_ID")
end

def extension_bundle_id
  "#{bundle_id}.ShareExtension"
end

def all_bundle_ids
  [bundle_id, extension_bundle_id]
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: false
  )
end

# The App Review contact (name, phone, email) is personal data, so it lives
# in GitHub secrets rather than in fastlane/metadata/review_information.
# Missing values are left untouched in App Store Connect.
def review_contact
  contact = {
    first_name: ENV["REVIEW_CONTACT_FIRST_NAME"],
    last_name: ENV["REVIEW_CONTACT_LAST_NAME"],
    phone_number: ENV["REVIEW_CONTACT_PHONE"],
    email_address: ENV["REVIEW_CONTACT_EMAIL"]
  }.reject { |_, value| value.nil? || value.empty? }
  contact.empty? ? nil : contact
end


platform :ios do
  desc "Build, sign, and upload a new build to TestFlight"
  lane :release do
    setup_ci
    key = asc_api_key

    match(
      type: "appstore",
      app_identifier: all_bundle_ids,
      api_key: key,
      readonly: true
    )

    increment_build_number(
      xcodeproj: project_path,
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", "1")
    )

    team = ENV.fetch("APP_TEAM_ID")

    update_code_signing_settings(
      path: project_path,
      use_automatic_signing: false,
      team_id: team,
      targets: ["SMBDrop"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{bundle_id}"
    )

    update_code_signing_settings(
      path: project_path,
      use_automatic_signing: false,
      team_id: team,
      targets: ["ShareExtension"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{extension_bundle_id}"
    )

    ipa_path = build_app(
      project: project_path,
      scheme: scheme_name,
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{team}",
      export_team_id: team,
      export_options: {
        provisioningProfiles: {
          bundle_id => "match AppStore #{bundle_id}",
          extension_bundle_id => "match AppStore #{extension_bundle_id}"
        }
      }
    )

    embedded_framework = "Payload/SMBDrop.app/Frameworks/AMSMB2.framework/AMSMB2"
    sh("unzip", "-l", ipa_path, embedded_framework)

    upload_to_testflight(
      api_key: key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Push the App Store listing metadata and privacy details"
  lane :metadata do
    key = asc_api_key

    # Earlier delete-all uploads raced App Store Connect's processing lag
    # and could strand a duplicate screenshot in a FAILED state, which the
    # checksum sync below refuses to run past. Clear any such leftovers.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: ENV.fetch("ASC_KEY_P8")
    )
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    version.get_app_store_version_localizations.each do |localization|
      localization.get_app_screenshot_sets.each do |set|
        seen_checksums = {}
        set.app_screenshots.each do |shot|
          state = shot.asset_delivery_state && shot.asset_delivery_state["state"]
          checksum = shot.source_file_checksum
          duplicate = checksum && seen_checksums[checksum]
          if state == "FAILED" || duplicate
            UI.important("Deleting #{shot.file_name} (state: #{state}#{duplicate ? ', duplicate' : ''})")
            shot.delete!
          elsif checksum
            seen_checksums[checksum] = true
          end
        end
      end
    end

    # The App Privacy nutrition label cannot be set through the API any
    # more (Apple removed the appDataUsages relationship), so "Data Not
    # Collected" is declared manually in App Store Connect → App Privacy.
    deliver(
      api_key: key,
      app_identifier: bundle_id,
      app_version: ENV.fetch("APP_MARKETING_VERSION", "1.0"),
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      app_review_information: review_contact,
      skip_binary_upload: true,
      skip_screenshots: false,
      # Checksum-based sync instead of delete-all + re-upload: the old mode
      # raced App Store Connect's processing lag and duplicated screenshots
      # it wrongly believed were missing.
      sync_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Create or refresh distribution signing assets for both targets"
  lane :init_signing do
    match(
      type: "appstore",
      app_identifier: all_bundle_ids,
      api_key: asc_api_key,
      readonly: false,
      # This manually-dispatched lane is also the recovery path after changing
      # App ID capabilities (for example, attaching an App Group). Regenerate
      # profiles so their entitlements always reflect the portal state.
      force: true
    )
  end
end
